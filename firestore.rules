rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradora: documento /admins/{uid} criado só pelo Console do Firebase.
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Validador: documento /validadores/{uid}, criado quando a administradora aprova o cadastro.
    function validador() {
      return request.auth != null
        && (admin() || exists(/databases/$(database)/documents/validadores/$(request.auth.uid)));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /validadores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if admin();
    }

    // Pedidos de cadastro (e-mail e senha): a pessoa cria o próprio pedido como "pendente";
    // só a administradora lê todos e decide.
    match /usuarios/{uid} {
      allow read: if admin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','setor','email','status','criadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && request.resource.data.setor is string && request.resource.data.setor.size() >= 1 && request.resource.data.setor.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]*sp\\.gov\\.br$');
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','por','decididoEm','papel'])
        && request.resource.data.status in ['aprovado','recusado','revogado'];
      allow delete: if false;
    }

    // Propostas: só envia quem está logado e com cadastro aprovado; a coordenação lê e decide; cada pessoa lê as suas próprias.
    match /propostas/{id} {
      allow read: if validador() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == 'aprovado'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
            ['uid','lote','nome','setor','email','acao','cid','ref','ano','titulo','area','antes','depois','just','ap','status','criadoEm'])
        && request.resource.data.keys().hasAll(['uid','lote','nome','setor','email','acao','cid','ref','just','ap','status','criadoEm'])
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && request.resource.data.setor is string && request.resource.data.setor.size() >= 1 && request.resource.data.setor.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@ ]+@[^@ ]*sp\\.gov\\.br$')
        && request.resource.data.just is string && request.resource.data.just.size() >= 10 && request.resource.data.just.size() <= 2000
        && request.resource.data.lote is string && request.resource.data.lote.size() <= 40
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 200
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 200
        && request.resource.data.cid is string && request.resource.data.cid.size() <= 100
        && request.resource.data.get('antes','') is string && request.resource.data.get('antes','').size() <= 2000
        && request.resource.data.get('depois','') is string && request.resource.data.get('depois','').size() <= 2000
        && request.resource.data.get('titulo','') is string && request.resource.data.get('titulo','').size() <= 1000
        && request.resource.data.get('area','') is string && request.resource.data.get('area','').size() <= 300
        && request.resource.data.ap is map
        && request.resource.data.ap.t in ['dest','ov','aj','vinc'];
      allow update: if validador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','val'])
        && request.resource.data.status in ['aprovada','recusada'];
      allow delete: if false;
    }

    // Rascunhos da revisão: cada pessoa (com cadastro aprovado) lê e grava só o seu.
    match /rascunhos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == 'aprovado'
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['itens','at'])
          && request.resource.data.itens is list && request.resource.data.itens.size() <= 600));
    }

    // Decisões já validadas: leitura pública (o painel mostra a todos); gravação só da coordenação.
    match /decisoes/{id} {
      allow read: if true;
      allow create, update: if validador() && request.resource.data.t in ['dest','ov','aj','vinc'];
      allow delete: if false;
    }

    // Histórico: só a coordenação lê; só cria (nunca altera nem apaga).
    match /auditoria/{id} {
      allow read: if validador();
      allow create: if validador();
      allow update, delete: if false;
    }
  }
}
